{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.1.0",
  "description": "__MSG_extDescription__",
  "default_locale": "zh_TW",
  "homepage_url": "https://github.com/BoringMan314/bm-ani-gamer-tool",
  "icons": {
    "128": "icons/icon.png"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_icon": {
      "128": "icons/icon.png"
    },
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ani.gamer.com.tw/*"
      ],
      "js": [
        "src/defaults.js",
        "src/core.js",
        "src/feature-speed-3x.js",
        "src/feature-cover-image.js",
        "src/feature-time-indicator.js",
        "src/feature-theater-topbar.js",
        "src/feature-adblock-prompt.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://ani.gamer.com.tw/*"
      ],
      "js": [
        "src/presence.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/injected-speed-3x.js"
      ],
      "matches": [
        "https://ani.gamer.com.tw/*"
      ]
    }
  ],
  "commands": {
    "skip90": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "__MSG_cmdSkip90Description__"
    }
  }
}
